-- return a book late (triggers fire)
UPDATE loans SET return_date = '2024-01-20' WHERE loan_id = 1;

-- ---------- SAMPLE QUERIES ----------
SELECT * FROM v_available_books;
SELECT * FROM v_overdue_loans;

SELECT p.patron_id, CONCAT(p.first_name,' ',p.last_name) AS patron,
       COUNT(l.loan_id) AS total_loans
FROM patrons p LEFT JOIN loans l ON p.patron_id = l.patron_id
GROUP BY p.patron_id ORDER BY total_loans DESC;

SELECT b.title, COUNT(l.loan_id) AS times_borrowed
FROM books b LEFT JOIN loans l ON b.book_id = l.book_id
GROUP BY b.book_id ORDER BY times_borrowed DESC LIMIT 5;

SELECT p.first_name, p.last_name, SUM(f.amount) AS total_fines
FROM patrons p
JOIN loans l ON p.patron_id = l.patron_id
JOIN fines f ON l.loan_id = f.loan_id
GROUP BY p.patron_id;
